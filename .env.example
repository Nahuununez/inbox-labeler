# Copy this file to .env for LOCAL use only:   cp .env.example .env
# .env is listed in .gitignore. NEVER commit it or paste its values anywhere.
# In GitHub Actions the same values are stored as repository secrets/variables.

# --- Gmail (required): printed once by `python -m inbox_labeler token` ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Gemini fallback (optional) ---
# Used only for messages that no rule in rules.yaml matches. It receives the
# sender address and subject (never the body). Leave empty for rules-only mode.
GEMINI_API_KEY=
# USE_GEMINI=false                 # force rules-only even if a key is set
# GEMINI_MODEL=                    # override the default model name
# GEMINI_CONFIDENCE_THRESHOLD=0.95 # minimum confidence to accept a Gemini label

# --- Rules file (optional) ---
# RULES_PATH=rules.yaml            # use a different rules file
